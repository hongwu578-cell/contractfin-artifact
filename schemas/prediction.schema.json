{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractfin.local/schemas/prediction.schema.json",
  "title": "ContractFin prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "answer", "evidence", "status"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "answer": {"type": ["string", "number", "boolean", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "document_id": {"type": "string"},
              "page": {"type": ["integer", "string"]},
              "text": {"type": "string"}
            }
          }
        ]
      }
    },
    "status": {"enum": ["answered", "abstain", "error", "human_review"]},
    "program": {"type": ["string", "array", "null"]},
    "unit": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}

